<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<Project>
  <General>
    <ProjectName>debug_console</ProjectName>
    <ProjectPath>debug_console.jdebug</ProjectPath>
  </General>
  <Debug>
    <Connect>
      <TargetDevice>RISC-V</TargetDevice>
      <TargetInterface>JTAG</TargetInterface>
      <InterfaceSpeed>4000</InterfaceSpeed>
      <JTAGConf>-1,-1</JTAGConf>
      <SN>REDACTED</SN>
    </Connect>
    <Data>
      <ElfFile>main.elf</ElfFile>
      <CodeEntry>0x00000000</CodeEntry>
      <LoadEntry>0x00000000</LoadEntry>
      <Breakpoint>main</Breakpoint>
    </Data>
  </Debug>
</Project>