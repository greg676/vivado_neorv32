# Recreates the Pt V2 PVLA + MIG7 capture project.
# PHY is the Au Lucid WR / 4 KiB burst core. No NeoRV32. No QSPI.
#
# From platforms/alchitry-platinum-v2:
#   vivado -mode batch -source tcl/rebuild_pvla_mig7.tcl
#
# Optional:
#   set skip_impl 1
#   set ft601_pinout "v2"   ;# default pt_alpha
#
if {![info exists ft601_pinout]} { set ft601_pinout "pt_alpha" }
if {![info exists skip_impl]}    { set skip_impl 0 }

set script_dir  [file dirname [file normalize [info script]]]
set plat_dir    [file dirname $script_dir]
set repo_root   [file dirname [file dirname $plat_dir]]
set au          [file join $repo_root platforms alchitry-au-v2]
set ip_xdc      [file join $repo_root ip pvla xdc]
set project_dir [file join $plat_dir vivado_project_pvla_mig7_top]
set part        xc7a100tfgg484-2

puts "PVLA MIG7 capture top (Pt V2)"
puts "  pinout : $ft601_pinout"
puts "  part   : $part"

create_project -force pvla_mig7_top $project_dir -part $part

add_files -fileset sources_1 [list \
    [file join $au rtl ft601 ft601_sync_fifo.v] \
    [file join $au rtl ft601 ft601_reset.v] \
    [file join $au rtl la la_pattern.v] \
    [file join $au rtl la la_pingpong_bram.v] \
    [file join $plat_dir rtl la la_dc_fwft.v] \
    [file join $plat_dir rtl la la_ddr3_axi_buf.v] \
    [file join $plat_dir rtl la pvla_mig7_capture_core.v] \
    [file join $plat_dir rtl la pvla_mig7_top.v] \
]

set pin_xdc [file join $ip_xdc ftplus_ft601_${ft601_pinout}.xdc]
if {![file exists $pin_xdc]} {
  set pin_xdc [file join $ip_xdc ftplus_ft601_pt_alpha.xdc]
}
add_files -fileset constrs_1 [list \
    [file join $plat_dir constraints pvla_mig7_top.xdc] \
    $pin_xdc \
    [file join $ip_xdc ftplus_ft601_timing.xdc] \
    [file join $ip_xdc ftplus_ft601_impl.xdc] \
]
set_property used_in_synthesis false [get_files -quiet *ftplus_ft601_impl.xdc]

set_property top pvla_mig7_top [current_fileset]
set_property generic C_SIM_MEM=0 [current_fileset]

puts "Create the MIG BD first: vivado -mode batch -source tcl/pvla_mig7_bd.tcl"
puts "Then add pvla_mig7_bd_wrapper as a source, or source this after that BD exists."
puts "RAM program (not flash)."

if {!$skip_impl} {
  puts "skip_impl=0 but BD wrapper is generated by pvla_mig7_bd.tcl — run that first."
}
